---
// TODO(image-optimization): assets/img/*.jpg,*.png and assets/video/*.mov are served
// as-is from public/assets/ via plain <img>/<video src>. A later pass should move the
// images into src/assets/img/ and adopt Astro's <Image> component for automatic
// resize/compression/format conversion (webp/avif). Video has no <Image> equivalent.
import BaseLayout from '../layouts/BaseLayout.astro';
import FlavourCard from '../components/FlavourCard.astro';
import WhyCard from '../components/WhyCard.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { flavours } from '../data/flavours';
import { why } from '../data/why';
import { recipes } from '../data/recipes';
import { testimonials } from '../data/testimonials';

// Split into three columns for the auto-scrolling marquee. Each column's cards
// are duplicated in the markup below so the vertical loop is seamless.
const tCols = [testimonials.slice(0, 3), testimonials.slice(3, 6), testimonials.slice(6, 9)];
---
<BaseLayout title="Babs Butter · Big Butter Energy">
  <!-- HERO -->
  <header class="hero" id="top">
    <img class="blob spin" src="/assets/shapes/flower.svg" alt="" style="width:min(46vw,560px);top:-8%;right:-10%;opacity:.4" />
    <img class="blob bob2" src="/assets/shapes/quatrefoil.svg" alt="" style="width:min(28vw,320px);bottom:-6%;left:-8%;opacity:.35" />
    <div class="float-i f1"><img src="/assets/illus/butter-stick.svg" alt="" /></div>
    <div class="float-i f2"><img src="/assets/illus/croissant.svg" alt="" /></div>
    <div class="float-i f3"><img src="/assets/illus/hearts.svg" alt="" /></div>
    <div class="float-i f4"><img src="/assets/illus/butter-swirl.svg" alt="" /></div>
    <div class="wrap">
      <span class="eyebrow">🧈 slow-churned &amp; a little silly</span>
      <h1><span class="w">Big</span> <span class="w">butter</span> <span class="w">energy.</span></h1>
      <p>Slow-churned, clean-label butter that takes the cream seriously and nothing else. Come play.</p>
      <div class="cta-row">
        <a class="btn magnetic" href="#flavs">Pick a flavour</a>
        <a class="btn blue" href="#why">Why it's better</a>
      </div>
    </div>

    <!-- TICKER TAPE — anchored to the base of the hero -->
    <div class="mq" aria-hidden="true">
      <div class="track">
        <span>Slow-churned <img src="/assets/illus/butter-swirl.svg" alt="" /> Clean label <img src="/assets/illus/bread-butter.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
        <span>Slow-churned <img src="/assets/illus/butter-swirl.svg" alt="" /> Clean label <img src="/assets/illus/bread-butter.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
      </div>
    </div>
  </header>

  <!-- ABOUT -->
  <section class="about">
    <div class="wrap">
      <h2 class="rv">Butter that's <em>good for you</em> and still fun at parties.</h2>
      <p class="rv">Cultured cream, a slow cold churn, and a label short enough to read out loud. That's the whole recipe. The rest is just us having a good time with it.</p>
    </div>
  </section>

  <!-- FLAVOURS -->
  <section class="flavs" id="flavs">
    <div class="wrap">
      <h2 class="rv">Pick your player</h2>
      <p class="lead rv">One serious churn, a colour for every craving.</p>
      <div class="flav-grid">
        {flavours.map((f) => <FlavourCard {...f} />)}
      </div>
    </div>
  </section>

  <!-- WHY -->
  <section class="why" id="why">
    <div class="wrap">
      <h2 class="rv">Why the fridge fights over it</h2>
      <div class="why-grid">
        {why.map((w) => <WhyCard {...w} />)}
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats">
    <div class="wrap">
      <!-- sample figures for client review -->
      <div class="row">
        <div class="stat rv"><div class="num" data-count="82">0</div><p>% butterfat</p></div>
        <div class="stat rv"><div class="num" data-count="3">0</div><p>ingredients</p></div>
        <div class="stat rv"><div class="num" data-count="48">0</div><p>hrs churn to shelf</p></div>
      </div>
    </div>
  </section>

  <!-- RECIPES -->
  <section class="recipes" id="recipes">
    <div class="wrap">
      <h2 class="rv">Cook something happy</h2>
      <p class="lead rv">Flick through. Get hungry. Repeat.</p>
    </div>
    <div class="wrap">
      <div class="r-track">
        {recipes.map((r) => <RecipeCard {...r} />)}
      </div>
    </div>
  </section>

  <!-- INGREDIENTS -->
  <section class="ing" id="ingredients">
    <div class="wrap">
      <h2 class="rv">The whole ingredient list</h2>
      <p class="lead rv">Yes, that's really all of it. Hover and say hi.</p>
      <div class="ing-pills rv">
        <span class="pill"><img src="/assets/illus/butter-swirl.svg" alt="" />cultured cream</span>
        <span class="pill"><img src="/assets/illus/butter-knife.svg" alt="" />sea salt</span>
        <span class="pill"><img src="/assets/illus/butter-dish.svg" alt="" />time</span>
      </div>
    </div>
  </section>

  <!-- VIDEO -->
  <section class="vid">
    <div class="wrap">
      <div class="frame rv">
        <video src="/assets/video/butter-table.mov" autoplay muted loop playsinline aria-label="Fresh butter on a wooden table, up close"></video>
        <span class="tag">🎬 fresh from the churn</span>
      </div>
    </div>
  </section>

  <!-- TESTIMONIALS -->
  <section class="quotes" aria-labelledby="quotes-heading">
    <div class="wrap">
      <div class="q-head rv">
        <span class="eyebrow">🧈 the group chat</span>
        <h2 id="quotes-heading">Buttered up, in their own words</h2>
        <p>Bakers, breakfast people and one dad who reads every label — here's what the churn does for them.</p>
      </div>
      <div class="q-cols" role="region" aria-label="Scrolling testimonials">
        {tCols.map((col, c) => (
          <div class={`q-col q-col-${c + 1}`}>
            <ul class="q-track">
              {[0, 1].map((dup) =>
                col.map((t) => (
                  <li class="q-card" aria-hidden={dup === 1 ? 'true' : 'false'}>
                    <blockquote>{t.text}</blockquote>
                    <figure class="q-who">
                      <img src={t.image} alt={`Photo of ${t.name}`} width="44" height="44" loading="lazy" />
                      <figcaption><cite>{t.name}<span>{t.role}</span></cite></figcaption>
                    </figure>
                  </li>
                ))
              )}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AWARDS + RETAIL -->
  <section class="shelf" id="stockists">
    <div class="wrap">
      <h2 class="rv">Shiny things &amp; where to grab us</h2>
      <div class="badges">
        <div class="b rv"><span class="yr">2026</span><span>Great Taste, two stars</span></div>
        <div class="b rv"><span class="yr">2026</span><span>Clean Label Pantry Award</span></div>
        <div class="b rv"><span class="yr">2026</span><span>Best New Dairy Brand</span></div>
      </div>
      <div class="retail rv">
        <p>On shelves at the good grocers, and delivered churn-fresh.</p>
        <div class="row"><span>Nature's Basket</span><span>Foodhall</span><span>Le Marché</span><span>Modern Bazaar</span><span>babsbutter.in</span></div>
      </div>
    </div>
  </section>

  <!-- GALLERY -->
  <section>
    <div class="wrap">
      <div class="gal-grid">
        <div class="g rv"><img src="/assets/img/table-spread-2.jpg" alt="Breakfast flat lay with butter cubes" loading="lazy" /></div>
        <div class="g rv"><img src="/assets/img/img-aristi.jpg" alt="Sliced butter with raspberries and seeded bread" loading="lazy" /></div>
        <div class="g rv"><img src="/assets/img/scoops.jpg" alt="Scoops of churned cream" loading="lazy" /></div>
        <div class="g rv"><img src="/assets/img/img-tkachenko.jpg" alt="A croissant in warm morning light" loading="lazy" /></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="wrap inner">
      <h2 class="rv">Good questions</h2>
      <details class="rv"><summary>What does "cultured" mean? <span class="x">+</span></summary><p>The cream ferments overnight with live cultures before churning. Deeper flavour, gentle tang, easier to digest.</p></details>
      <details class="rv"><summary>Is the plant-based tub actually good? <span class="x">+</span></summary><p>Churned like our dairy butter, from oat cream and cold-pressed oils. It browns, bakes and fools butter loyalists.</p></details>
      <details class="rv"><summary>Where can I buy Babs? <span class="x">+</span></summary><p>Premium grocers across the metros, or straight from babsbutter.in in an insulated box, churn-fresh.</p></details>
      <details class="rv"><summary>How long does a tub last? <span class="x">+</span></summary><p>Three months chilled, unopened. Opened, about a week, and not because it spoils.</p></details>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta" id="cta">
    <div class="wrap">
      <div class="card">
        <img class="blob bob" src="/assets/shapes/ribbed-circle.svg" alt="" style="width:280px;left:-80px;top:-60px;opacity:.3" />
        <img class="blob bob2" src="/assets/shapes/butter-curl.svg" alt="" style="width:240px;right:-70px;bottom:-50px;opacity:.3" />
        <h2 class="rv">Go on, <em>butter</em> something.</h2>
        <p class="rv">Find your nearest shelf, or get it delivered cold, fast and churn-fresh.</p>
        <a class="btn cream magnetic rv" href="#stockists">Find Babs near you</a>
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap">
      <div class="f-grid">
        <div><img src="/assets/logos/secondary-flour.svg" alt="Babs Butter" /></div>
        <div><h4>Shop</h4><ul><li><a href="#flavs">Classic Salted</a></li><li><a href="#flavs">Plant-Based</a></li><li><a href="#flavs">Berry Whipped</a></li></ul></div>
        <div><h4>Explore</h4><ul><li><a href="#why">Why Babs</a></li><li><a href="#recipes">Recipes</a></li><li><a href="#faq">FAQ</a></li></ul></div>
        <div><h4>Follow</h4><ul><li><a href="#">@babsbutterofficial</a></li><li><a href="#">babsbutter.in</a></li></ul></div>
      </div>
      <div class="f-base"><span>© 2026 Babs Butter. Healthy never tasted this rich.</span><span>Privacy · Terms</span></div>
    </div>
  </footer>
</BaseLayout>
