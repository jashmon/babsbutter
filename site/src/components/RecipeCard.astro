---
import type { Recipe } from '../data/recipes';
type Props = Recipe;
const { title, meta, img, alt } = Astro.props;
---
<article class="r-card">
  <div class="ph"><img src={img} alt={alt} loading="lazy" /></div>
  <div class="cap">
    <h3>{title}</h3>
    <span>{meta}</span>
  </div>
</article>
