---
import '../styles/global.css';
import NotifyModal from '../components/NotifyModal.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Babs Butter · Big Butter Energy',
  description = 'Slow-churned, clean-label butter that takes the cream seriously and nothing else. Come play.',
} = Astro.props;

// The nav lives here, so its in-page anchors have to resolve from any route.
// On the homepage they stay bare hashes (main.js hands those to Lenis for the
// smooth scroll); anywhere else they're prefixed so they navigate home first.
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const to = (hash: string) => (isHome ? hash : `/${hash}`);
const path = Astro.url.pathname.replace(/\/$/, '');
const onPlantPage = path === '/plant-based';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />

    <!--
      Runs synchronously before first paint. Two jobs:
        1. Add `.js` (progressive-enhancement hook for any JS-gated CSS).
        2. Set scroll restoration to manual so the browser doesn't animate a
           scroll back to the previous position on reload — with
           html{scroll-behavior:smooth} that restore is smooth, and reads as the
           whole page sliding up on every refresh. Manual = load at top, instantly.
      Must stay is:inline — an external fetch would run too late (after the
      browser has already begun restoring scroll).
    -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        } catch (e) {}
      })();
    </script>

    <link rel="preload" href="/assets/fonts/Roketto.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/assets/fonts/PublicSans.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="/assets/fonts.css" />
  </head>
  <body>
    <!-- Preloader: spinning Babs mark + "churning…", sweeps up on load (see global.css).
         JS-gated (hidden without JS) and removed outright under reduced motion. -->
    <div id="preloader" class="preloader" aria-hidden="true">
      <div class="pl-inner">
        <img class="mark" src="/assets/logos/tertiary-2-tangerine.svg" alt="" />
        <p class="churn">churning<span class="d">.</span><span class="d">.</span><span class="d">.</span></p>
      </div>
    </div>

    <div id="blob" aria-hidden="true"></div>

    <nav>
      <div class="bar">
        <a class="logo" href={isHome ? '#top' : '/'} aria-label="Babs Butter">
          <span class="logo-icon-wrap">
            <img class="logo-icon" src="/assets/logos/icon-tangerine.svg" alt="" />
          </span>
          <img class="logo-word" src="/assets/logos/primary-tangerine.svg" alt="" />
        </a>
        <ul id="nav-links">
          <span class="nav-pill" aria-hidden="true"></span>
          <li>
            <a href="/plant-based" aria-current={onPlantPage ? 'page' : undefined}>Plant-Based</a>
          </li>
          <li><a href={to('#why')}>Why Babs</a></li>
          <li><a href={to('#recipes')}>Recipes</a></li>
          <li><a href={to('#faq')}>FAQ</a></li>
        </ul>
        <button class="btn small" type="button" data-notify-open>Get Babs</button>
        <!-- mobile only (hidden ≥1025px); drives the dropdown panel above -->
        <button
          id="nav-toggle"
          class="nav-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="nav-links"
        >
          <span class="nav-toggle-box" aria-hidden="true"><span></span><span></span><span></span></span>
        </button>
      </div>
    </nav>

    <slot />

    <NotifyModal />

    <script src="../scripts/main.js"></script>
  </body>
</html>
