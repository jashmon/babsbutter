---
// TODO(image-optimization): assets/img/*.jpg,*.png and assets/video/*.mov are served
// as-is from public/assets/ via plain <img>/<video src>. A later pass should move the
// images into src/assets/img/ and adopt Astro's <Image> component for automatic
// resize/compression/format conversion (webp/avif). Video has no <Image> equivalent.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureBurst from '../components/FeatureBurst.astro';
import FlavourCard from '../components/FlavourCard.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { flavours } from '../data/flavours';
import { recipes } from '../data/recipes';
import { testimonials } from '../data/testimonials';

// The two hero decorative shapes are inlined (not <img>) so main.js can
// line-draw their outline on load via anime.js's createDrawable, then fade the
// brand fill up — see playHeroIntro() + the .hero-shape rules in global.css.
// Read at build time from the same source files the rest of the site uses.
// Anchored to the project root (cwd during `astro dev`/`astro build`) rather
// than import.meta.url, which points into the bundled output at build time.
const shapeSvg = (name: string) =>
  readFileSync(join(process.cwd(), 'public/assets/shapes', `${name}.svg`), 'utf8');
const flowerSvg = shapeSvg('flower');
const quatrefoilSvg = shapeSvg('quatrefoil');

// Recipe "window" clip-path. The photos are clipped into the quatrefoil brand
// shape; while the "Cook something happy" section is in view, main.js morphs
// that shape into the rounded square below (anime.js morphTo) and eases it back
// on scroll-away. Both paths are pre-normalised to the 0..1 objectBoundingBox
// space so the clip scales with each (square) card and no transform is needed.
// The quatrefoil path is pure M/C/c (coordinate pairs only), so scaling every
// number alternately by (1/w, 1/h) normalises it exactly.
const QUAT_W = 693.46;
const QUAT_H = 706.42;
const normalizePath = (d: string, sx: number, sy: number) => {
  let i = 0;
  return d.replace(/([A-Za-z])|(-?\d*\.?\d+)/g, (_m, cmd, num) => {
    if (cmd) {
      i = 0;
      return cmd;
    }
    const v = parseFloat(num) * (i++ % 2 === 0 ? sx : sy);
    return v.toFixed(5);
  });
};
const quatrefoilD = normalizePath(quatrefoilSvg.match(/ d="([^"]+)"/)![1], 1 / QUAT_W, 1 / QUAT_H);
// Rounded square in 0..1 space (corner radius 0.16 ≈ the quatrefoil's lobe
// scale). Corners are cubic béziers, NOT arcs — anime's morphTo samples path
// commands and doesn't handle `A`, so an arc target collapses to a single point.
const recipeSquareD =
  'M0.16,0 L0.84,0 C0.928368,0 1,0.071632 1,0.16 L1,0.84 C1,0.928368 0.928368,1 0.84,1 L0.16,1 C0.071632,1 0,0.928368 0,0.84 L0,0.16 C0,0.071632 0.071632,0 0.16,0 Z';

// Product stats folded into the merged feature section (sample figures for
// client review). The count-up is driven by main.js via [data-count].
const stats = [
  { num: 82, label: '% butterfat' },
  { num: 3, label: 'ingredients' },
  { num: 48, label: 'hrs to shelf' },
];

// Split into three columns for the auto-scrolling marquee. Each column's cards
// are duplicated in the markup below so the vertical loop is seamless.
const tCols = [testimonials.slice(0, 3), testimonials.slice(3, 6), testimonials.slice(6, 9)];

// Brand-element shapes cycled onto testimonial avatars (Brand Elements – Shapes).
const qShapes = ['/assets/shapes/quatrefoil.svg', '/assets/shapes/flower.svg', '/assets/shapes/ribbed-circle.svg'];

// Photos that drift as the tilted marquee background behind the stockists
// section. Each row repeats its set twice in the markup so the translateX(-50%)
// loop wraps seamlessly (see .shelf-bg in global.css). Alternate rows run the
// set reversed and scroll the opposite way for a parallax collage.
const shelfPhotos = ['table-spread-2', 'img-aristi', 'scoops', 'img-tkachenko', 'butter-rolls', 'img-tai-1', 'banana-cream', 'img-solodsha'];
const shelfRows = [
  { cls: 'r1', imgs: shelfPhotos },
  { cls: 'r2 rev', imgs: [...shelfPhotos].reverse() },
  { cls: 'r3', imgs: shelfPhotos },
  { cls: 'r4 rev', imgs: [...shelfPhotos].reverse() },
  { cls: 'r5', imgs: shelfPhotos },
];
---
<BaseLayout title="Babs Butter · Big Butter Energy">
  <!-- OFFER STRIP — fixed announcement bar above the nav -->
  <div class="promo" role="region" aria-label="Store announcement">
    <div class="wrap promo-inner">
      <span class="promo-msg">Free delivery on orders over ₹800 · churn-fresh, cold-shipped</span>
      <div class="promo-social" aria-hidden="true">
        <span>@babsbutter</span>
        <span class="promo-cur">INR ₹</span>
      </div>
    </div>
  </div>

  <!-- HERO — full-bleed lifestyle photo background -->
  <header class="hero" id="top">
    <img class="hero-bgimg" src="/assets/img/table-spread.jpg" alt="A table spread of warm bread, pastries and butter" />
    <div class="hero-scrim" aria-hidden="true"></div>
    <span class="blob spin hero-shape" aria-hidden="true" style="width:min(46vw,560px);top:-8%;right:-10%;opacity:.4" set:html={flowerSvg}></span>
    <span class="blob bob2 hero-shape" aria-hidden="true" style="width:min(28vw,320px);bottom:-6%;left:-8%;opacity:.35" set:html={quatrefoilSvg}></span>
    <div class="float-i f1"><img src="/assets/illus/butter-stick.svg" alt="" /></div>
    <div class="float-i f2"><img src="/assets/illus/croissant.svg" alt="" /></div>
    <div class="float-i f3"><img src="/assets/illus/hearts.svg" alt="" /></div>
    <div class="float-i f4"><img src="/assets/illus/butter-swirl.svg" alt="" /></div>
    <div class="wrap">
      <span class="eyebrow">slow-churned &amp; a little silly</span>
      <h1><span class="w">Big</span> <span class="w">butter</span> <span class="w">energy.</span></h1>
      <p>Slow-churned, clean-label butter that takes the cream seriously and nothing else. Come play.</p>
      <div class="cta-row">
        <a class="btn biscuit magnetic" href="#flavs">Pick a flavour</a>
        <a class="btn blue" href="#why">Why it's better</a>
      </div>
    </div>

    <!-- TICKER TAPE — anchored to the base of the hero, tilted like a sticker -->
    <div class="mq tilt-l" aria-hidden="true">
      <div class="track">
        <span>Slow-churned <img src="/assets/illus/butter-swirl.svg" alt="" /> Clean label <img src="/assets/illus/bread-butter.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
        <span>Slow-churned <img src="/assets/illus/butter-swirl.svg" alt="" /> Clean label <img src="/assets/illus/bread-butter.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
      </div>
    </div>
  </header>

  <!-- FLAVOURS — the "Pick your player" grid; brand-element shapes as the tub
       outlines. Now the first content section, so it carries the scalloped flour
       wave in from the hero. #flavs lands here. -->
  <section class="flavs wv" id="flavs" style="--wv-c:var(--flour)">
    <div class="flav-bg" aria-hidden="true"></div>
    <div class="wrap">
      <h2 class="rv">Pick your player</h2>
      <p class="lead rv">One serious churn, a colour for every craving.</p>
      <div class="flav-grid">
        {flavours.map((f) => <FlavourCard {...f} />)}
      </div>
    </div>
  </section>

  <!-- PRODUCT FEATURES — the merged spiral feature section (burst + "Zero
       nasties" + stats, folding in the old why/stats sections). Sits below the
       flavours grid now; #why lands on the feature section. -->
  <FeatureBurst id="why" ctaHref="#stockists" stats={stats} />

  <!-- HOW IT'S CHURNED — photo steps; wave in from the flour flavours grid -->
  <section class="made wv no-depth" style="--wv-c:var(--flour)">
    <div class="wrap">
      <h2 class="rv">From cream to keeper</h2>
      <div class="made-grid">
        <div class="made-step rv"><span class="n">01</span><div class="ph"><img src="/assets/img/scoops.jpg" alt="Fresh cream being cultured" loading="lazy" /></div><h3>Culture</h3><p>Fresh cream ferments overnight with live cultures, the old-world way.</p></div>
        <div class="made-step rv"><span class="n">02</span><div class="ph"><img src="/assets/img/baking-bowl.jpg" alt="Small-batch cold churn" loading="lazy" /></div><h3>Churn</h3><p>Turned cold and slow in small batches so the fat keeps its structure.</p></div>
        <div class="made-step rv"><span class="n">03</span><div class="ph"><img src="/assets/img/butter-cube-dark.jpg" alt="A finished cube of cultured butter" loading="lazy" /></div><h3>Taste &amp; seal</h3><p>Every batch is tasted, then sealed cold and shipped within 48 hours.</p></div>
      </div>
    </div>
  </section>

  <!-- RECIPES -->
  <section class="recipes no-depth" id="recipes">
    <!-- Per-card clip-paths for the recipe photos + the rounded-square target the
         boundary morphs to on hover (see main.js). 0×0 so it never paints. Each
         morphable shape (#rc-live-i) is a DIRECT child of the <svg>, not inside
         <clipPath> — paths inside a clipPath aren't in the render tree, so their
         getPointAtLength() can't be sampled. The clipPath references it live via
         <use>, so morphing #rc-live-i re-clips only that card's photo. One per
         card so hovering a single card morphs only its own boundary. -->
    <svg width="0" height="0" aria-hidden="true" class="rc-defs">
      {recipes.map((_, i) => (
        <Fragment>
          <path id={`rc-live-${i}`} class="rc-path" d={quatrefoilD} />
          <clipPath id={`recipe-clip-${i}`} clipPathUnits="objectBoundingBox">
            <use href={`#rc-live-${i}`} />
          </clipPath>
        </Fragment>
      ))}
      <path id="rc-square" d={recipeSquareD} />
    </svg>
    <div class="wrap">
      <h2 class="rv">Cook something happy</h2>
      <p class="lead rv">Flick through. Get hungry. Repeat.</p>
    </div>
    <div class="wrap">
      <div class="r-track" data-lenis-prevent>
        {recipes.map((r, i) => <RecipeCard {...r} index={i} />)}
      </div>
    </div>
  </section>

  <!-- INGREDIENTS — floating playground -->
  <section class="ing wv" id="ingredients" style="--wv-c:var(--flour)">
    <img class="blob spin" src="/assets/shapes/ribbed-circle.svg" alt="" style="width:min(24vw,260px);top:-4%;left:-6%;opacity:.25" />
    <div class="ing-float i1"><img src="/assets/illus/croissant.svg" alt="" /></div>
    <div class="ing-float i2"><img src="/assets/illus/butter-stick.svg" alt="" /></div>
    <div class="ing-float i3"><img src="/assets/illus/hearts.svg" alt="" /></div>
    <div class="ing-float i4"><img src="/assets/illus/bread-butter.svg" alt="" /></div>
    <div class="ing-float i5"><img src="/assets/illus/exclamation.svg" alt="" /></div>
    <div class="wrap">
      <h2 class="rv">The whole ingredient list</h2>
      <p class="lead rv">Yes, that's really all of it. Everything else floated away.</p>
      <div class="ing-stage rv">
        <span class="pill p1"><img src="/assets/illus/butter-swirl.svg" alt="" />cultured cream</span>
        <span class="pill p2"><img src="/assets/illus/butter-knife.svg" alt="" />sea salt</span>
        <span class="pill p3"><img src="/assets/illus/butter-dish.svg" alt="" />time</span>
      </div>
    </div>
  </section>

  <!-- VIDEO — full bleed, no white space; biscuit wave in from the ingredients above -->
  <section class="vid wv" style="--wv-c:var(--biscuit)">
    <video src="/assets/video/butter-table.mp4" poster="/assets/video/butter-table-poster.jpg" autoplay muted playsinline preload="auto" aria-label="A fresh stick of butter with warm bread and pastries on the table"></video>
    <span class="tag">🎬 fresh from the churn</span>
  </section>

  <!-- TICKER TAPE reprise — tilted the other way -->
  <div class="mq tilt-r solo" aria-hidden="true">
    <div class="track">
      <span>Slow-churned <img src="/assets/illus/butter-swirl.svg" alt="" /> Clean label <img src="/assets/illus/bread-butter.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
      <span>Slow-churned <img src="/assets/illus/butter-swirl.svg" alt="" /> Clean label <img src="/assets/illus/bread-butter.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
    </div>
  </div>

  <!-- TESTIMONIALS — no wave here; the tilted banner is the only break after the video -->
  <section class="quotes" aria-labelledby="quotes-heading">
    <img class="blob bob" src="/assets/shapes/quatrefoil.svg" alt="" style="width:min(20vw,220px);top:6%;left:-5%;opacity:.35" />
    <img class="blob bob2" src="/assets/shapes/flower.svg" alt="" style="width:min(24vw,280px);bottom:4%;right:-6%;opacity:.35" />
    <div class="wrap">
      <div class="q-head rv">
        <span class="eyebrow">🧈 the group chat</span>
        <h2 id="quotes-heading">Buttered up, in their own words</h2>
        <p>Bakers, breakfast people and one dad who reads every label — here's what the churn does for them.</p>
      </div>
      <div class="q-cols" role="region" aria-label="Scrolling testimonials">
        {tCols.map((col, c) => (
          <div class={`q-col q-col-${c + 1}`}>
            <ul class="q-track">
              {[0, 1].map((dup) =>
                col.map((t, i) => (
                  <li class="q-card" aria-hidden={dup === 1 ? 'true' : 'false'}>
                    <img class="q-shape" src={qShapes[(i + c) % qShapes.length]} alt="" aria-hidden="true" />
                    <blockquote>{t.text}</blockquote>
                    <figure class="q-who">
                      <span class="q-ava" style={`--shape:url('${qShapes[(i + c + 1) % qShapes.length]}')`}>
                        <img src={t.image} alt={`Photo of ${t.name}`} width="52" height="52" loading="lazy" />
                      </span>
                      <figcaption><cite>{t.name}<span>{t.role}</span></cite></figcaption>
                    </figure>
                  </li>
                ))
              )}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- AWARDS + RETAIL — the shelf pins (sticky) while the photo panel below
       scrolls up and over it; see .stack-over in global.css + the bottom-pin in main.js -->
  <div class="stack-over">
  <section class="shelf wv" id="stockists" style="--wv-c:var(--butter)">
    <div class="shelf-bg" aria-hidden="true">
      <div class="shelf-carousel">
        {shelfRows.map((row) => (
          <div class={`mrow ${row.cls}`}>
            {[...row.imgs, ...row.imgs].map((name) => (
              <span class="mcard"><img src={`/assets/img/${name}.jpg`} alt="" loading="lazy" /></span>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div class="wrap">
      <h2 class="rv">Shiny things &amp; where to grab us</h2>
      <div class="badges">
        <div class="b rv"><span class="yr">2026</span><span>Great Taste, two stars</span></div>
        <div class="b rv"><span class="yr">2026</span><span>Clean Label Pantry Award</span></div>
        <div class="b rv"><span class="yr">2026</span><span>Best New Dairy Brand</span></div>
      </div>
      <div class="retail rv">
        <p>On shelves at the good grocers, delivered churn-fresh — or at your door in ten minutes.</p>
        <div class="row quick">
          <a class="qcom" href="#" aria-label="Order on Zepto"><img src="/assets/logos/zepto.svg" alt="Zepto" /></a>
          <a class="qcom" href="#" aria-label="Order on Blinkit"><img class="bl" src="/assets/logos/blinkit.svg" alt="Blinkit" /><span>blinkit</span></a>
        </div>
        <div class="row"><span>Nature's Basket</span><span>Foodhall</span><span>Le Marché</span><span>Modern Bazaar</span><span>babsbutter.in</span></div>
      </div>
    </div>
  </section>

  <!-- FULL-BLEED PHOTO PANEL — wavy top edge is cut into the panel itself (see
       .ipanel mask in global.css); butterfly-pea wave out to the FAQ below -->
  <section class="ipanel wv">
    <img src="/assets/img/bread-basket.jpg" alt="Warm bread and butter on the table" loading="lazy" />
    <div class="scrim" aria-hidden="true"></div>
    <div class="txt">
      <span class="idx">No. 01 — the golden rule</span>
      <h3>Warm bread deserves better.</h3>
      <p>Room-temperature Babs, a heavy hand, and no regrets. That's the whole technique.</p>
    </div>
  </section>
  </div>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="wrap faq-grid">
      <div class="faq-side">
        <h2 class="rv">Good questions</h2>
        <p class="rv">Everything people ask us at farmers' markets, minus the free samples.</p>
        <img class="faq-illus" src="/assets/illus/exclamation.svg" alt="" aria-hidden="true" />
      </div>
      <div class="faq-list">
        <details class="rv"><summary>What does "cultured" mean? <span class="x">+</span></summary><div class="a"><p>The cream ferments overnight with live cultures before churning. Deeper flavour, gentle tang, easier to digest.</p></div></details>
        <details class="rv"><summary>Is the plant-based tub actually good? <span class="x">+</span></summary><div class="a"><p>Churned like our dairy butter, from oat cream and cold-pressed oils. It browns, bakes and fools butter loyalists.</p></div></details>
        <details class="rv"><summary>Where can I buy Babs? <span class="x">+</span></summary><div class="a"><p>Premium grocers across the metros, Zepto and Blinkit in minutes, or straight from babsbutter.in in an insulated box.</p></div></details>
        <details class="rv"><summary>How long does a tub last? <span class="x">+</span></summary><div class="a"><p>Three months chilled, unopened. Opened, about a week, and not because it spoils.</p></div></details>
      </div>
    </div>
  </section>

  <!-- CTA — full-bleed tangerine, concept-2 style -->
  <section class="cta wv" id="cta" style="--wv-c:var(--butterfly-pea)">
    <img class="q" src="/assets/shapes/quatrefoil.svg" alt="" />
    <img class="f" src="/assets/shapes/butter-curl.svg" alt="" />
    <div class="wrap">
      <h2 class="rv">Go on, <em>butter</em> something.</h2>
      <p class="rv">Find your nearest shelf, or get it delivered cold, fast and churn-fresh.</p>
      <a class="btn cream magnetic rv" href="#stockists">Find Babs near you</a>
    </div>
  </section>

  <footer class="wv" style="--wv-c:var(--tangerine)">
    <div class="wrap">
      <div class="f-grid">
        <div><img src="/assets/logos/secondary-flour.svg" alt="Babs Butter" /></div>
        <div><h4>Shop</h4><ul><li><a href="#flavs">Classic Salted</a></li><li><a href="#flavs">High Protein</a></li><li><a href="#flavs">Plant-Based</a></li><li><a href="#flavs">Dairy Free</a></li></ul></div>
        <div><h4>Explore</h4><ul><li><a href="#why">Why Babs</a></li><li><a href="#recipes">Recipes</a></li><li><a href="#faq">FAQ</a></li></ul></div>
        <div><h4>Follow</h4><ul><li><a href="#">@babsbutterofficial</a></li><li><a href="#">babsbutter.in</a></li></ul></div>
      </div>
      <div class="f-base"><span>© 2026 Babs Butter. Healthy never tasted this rich.</span><span>Privacy · Terms</span></div>
    </div>
  </footer>
</BaseLayout>
