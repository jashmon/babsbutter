---
// Plant-Based product page. Reuses the shared BaseLayout (nav, preloader,
// cursor glow) and the global design language — wave dividers, brand shapes as
// masks, the tilted marquee band, hairline borders and soft tinted shadows —
// but leans on Matcha as the page accent, matching the Plant Based tub in the
// packaging colour system. Page-specific styling is Astro-scoped so nothing
// here can affect the homepage.
import BaseLayout from '../layouts/BaseLayout.astro';

const benefits = [
  {
    icon: '/assets/illus/vegan.svg',
    title: 'Plant, not dairy',
    body: 'Oat cream and cold-pressed oils. No dairy, no palm oil, no hydrogenated anything.',
  },
  {
    icon: '/assets/illus/butter-swirl.svg',
    title: 'Churned, not blended',
    body: 'Same cold, slow churn as our dairy tubs, so it sets with real structure instead of a spreadable paste.',
  },
  {
    icon: '/assets/illus/hearts.svg',
    title: 'Kinder to the planet',
    body: 'Oats need a fraction of the land and water a dairy herd does, and we source ours close to the churn.',
  },
  {
    icon: '/assets/illus/handshake.svg',
    title: 'One tub for everyone',
    body: 'One tub the whole table can share, whatever each person happens to be eating this month.',
  },
];

// Brand-element shapes used as photo masks, mirroring the flavour cards.
const steps = [
  {
    n: '01',
    shape: '/assets/shapes/ribbed-circle.svg',
    img: '/assets/img/scoops.jpg',
    alt: 'Oat cream being cultured',
    title: 'Culture the oat cream',
    body: 'Live cultures go to work overnight, building the gentle tang that makes butter taste like butter.',
  },
  {
    n: '02',
    shape: '/assets/shapes/quatrefoil.svg',
    img: '/assets/img/baking-bowl.jpg',
    alt: 'Cold-pressed oils folded into the churn',
    title: 'Fold in the oils',
    body: 'Cold-pressed sunflower and coconut, balanced so it stays firm in the fridge and melts on warm toast.',
  },
  {
    n: '03',
    shape: '/assets/shapes/flower.svg',
    img: '/assets/img/butter-cube-dark.jpg',
    alt: 'The finished plant-based block',
    title: 'Churn cold, seal cold',
    body: 'Turned slow so the fat keeps its crystal structure, then tasted, sealed and shipped within forty-eight hours.',
  },
];

const uses = [
  { k: 'Spreading', v: 'Straight from the fridge, no tearing the bread.' },
  { k: 'Baking', v: 'Swap it one-for-one. Pastry still laminates.' },
  { k: 'Frying', v: 'Browns and foams like the dairy tub does.' },
  { k: 'Finishing', v: 'Melts glossy over greens, corn and rice.' },
];
---

<BaseLayout
  title="Plant-Based · Babs Butter"
  description="Babs Plant-Based: oat cream and cold-pressed oils, churned cold and slow. Dairy-free butter that browns, bakes and behaves like the real thing."
>
  <!-- HERO -->
  <header class="pb-hero" id="top">
    <img class="blob spin pb-blob-a" src="/assets/shapes/flower.svg" alt="" />
    <img class="blob bob2 pb-blob-b" src="/assets/shapes/quatrefoil.svg" alt="" />
    <div class="pb-float f1"><img src="/assets/illus/vegan.svg" alt="" /></div>
    <div class="pb-float f2"><img src="/assets/illus/bread-butter.svg" alt="" /></div>
    <div class="pb-float f3"><img src="/assets/illus/butter-swirl.svg" alt="" /></div>

    <div class="wrap pb-hero-grid">
      <div class="pb-hero-copy">
        <span class="pb-eyebrow">🌱 dairy-free, still rich</span>
        <h1>Plants never tasted<br /><em>this</em> buttery.</h1>
        <p>
          Cultured oat cream and cold-pressed oils, churned on the same cold, slow line as everything
          else we make. It browns, it bakes, it fools butter loyalists.
        </p>
        <div class="pb-cta-row">
          <a class="btn magnetic" href="#pb-inside">What's inside</a>
          <a class="btn cream" href="#pb-get">Where to buy</a>
        </div>
      </div>
      <div class="pb-hero-tub">
        <span class="pb-tub-shape"><img src="/assets/img/tubs/tub-plant.jpg" alt="Babs plant based buttrly spread tub" /></span>
      </div>
    </div>
  </header>

  <!-- MARQUEE -->
  <div class="mq tilt-l pb-mq" aria-hidden="true">
    <div class="track">
      <span>Oat cream <img src="/assets/illus/vegan.svg" alt="" /> No palm oil <img src="/assets/illus/butter-swirl.svg" alt="" /> Bakes like butter <img src="/assets/illus/croissant.svg" alt="" /> Dairy-free <img src="/assets/illus/hearts.svg" alt="" /></span>
      <span>Oat cream <img src="/assets/illus/vegan.svg" alt="" /> No palm oil <img src="/assets/illus/butter-swirl.svg" alt="" /> Bakes like butter <img src="/assets/illus/croissant.svg" alt="" /> Dairy-free <img src="/assets/illus/hearts.svg" alt="" /></span>
    </div>
  </div>

  <!-- STATEMENT -->
  <section class="pb-statement">
    <div class="wrap">
      <h2 class="rv">Most plant butters are a compromise. <em>This one isn't.</em></h2>
      <p class="rv">
        We didn't set out to make an alternative. We set out to make a butter that happens to have no
        dairy in it, and then refused to ship it until it behaved like the tubs beside it.
      </p>
    </div>
  </section>

  <!-- BENEFITS -->
  <section class="pb-benefits wv" style="--wv-c:var(--flour)">
    <div class="wrap">
      <h2 class="rv">Why people keep reaching for it</h2>
      <div class="pb-ben-grid">
        {
          benefits.map((b) => (
            <article class="pb-ben rv">
              <span class="pb-ben-ic"><img src={b.icon} alt="" /></span>
              <h3>{b.title}</h3>
              <p>{b.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- INSIDE / PROCESS -->
  <section class="pb-inside wv" id="pb-inside" style="--wv-c:var(--butterfly-pea)">
    <div class="wrap">
      <h2 class="rv">Three things, one churn</h2>
      <p class="pb-lead rv">Short enough to read out loud, same as always.</p>
      <div class="pb-step-grid">
        {
          steps.map((s) => (
            <article class="pb-step rv">
              <div class="pb-step-ph" style={`--shape:url('${s.shape}')`}>
                <img src={s.img} alt={s.alt} loading="lazy" />
              </div>
              <span class="pb-step-n">{s.n}</span>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FULL-BLEED PANEL -->
  <section class="pb-panel">
    <img src="/assets/img/img-tai-1.jpg" alt="Plant-based butter spread thickly on fresh bread" loading="lazy" />
    <div class="pb-panel-scrim" aria-hidden="true"></div>
    <div class="pb-panel-txt">
      <h3>It melts. That's the whole test.</h3>
      <p>If it sits on warm toast in a sad little lump, it isn't finished. Ours doesn't.</p>
    </div>
  </section>

  <!-- HOW IT BEHAVES -->
  <section class="pb-uses wv" style="--wv-c:var(--flour)">
    <div class="wrap">
      <h2 class="rv">Swap it one-for-one</h2>
      <p class="pb-lead rv">No ratio maths, no extra liquid, no apologising to the recipe.</p>
      <div class="pb-use-grid">
        {
          uses.map((u) => (
            <div class="pb-use rv">
              <h4>{u.k}</h4>
              <p>{u.v}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="pb-cta wv" id="pb-get" style="--wv-c:var(--flour)">
    <img class="pb-cta-shape a" src="/assets/shapes/butter-curl.svg" alt="" />
    <img class="pb-cta-shape b" src="/assets/shapes/quatrefoil.svg" alt="" />
    <div class="wrap">
      <h2 class="rv">Take the <em>green</em> one home.</h2>
      <p class="rv">On the shelf next to the rest of the family, and at your door in minutes.</p>
      <div class="pb-cta-row">
        <a class="btn cream magnetic rv" href="/#stockists">Find a stockist</a>
        <a class="btn rv" href="/#flavs">See every flavour</a>
      </div>
    </div>
  </section>

  <footer class="wv" style="--wv-c:var(--matcha)">
    <div class="wrap">
      <div class="f-grid">
        <div><img src="/assets/logos/secondary-flour.svg" alt="Babs Butter" /></div>
        <div><h4>Shop</h4><ul><li><a href="/#flavs">Classic Salted</a></li><li><a href="/#flavs">High Protein</a></li><li><a href="/plant-based">Plant-Based</a></li><li><a href="/#flavs">Dairy Free</a></li></ul></div>
        <div><h4>Explore</h4><ul><li><a href="/#why">Why Babs</a></li><li><a href="/#recipes">Recipes</a></li><li><a href="/#faq">FAQ</a></li></ul></div>
        <div><h4>Follow</h4><ul><li><a href="#">@babsbutterofficial</a></li><li><a href="#">babsbutter.in</a></li></ul></div>
      </div>
      <div class="f-base"><span>© 2026 Babs Butter. Healthy never tasted this rich.</span><span>Privacy · Terms</span></div>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ===== Plant-Based page =================================================
     Astro-scoped: every selector below is rewritten to this page only, so the
     homepage is untouched. Matcha is the page accent (the Plant Based tub's
     colour in the packaging system); everything else — shapes, hairlines,
     soft shadows, wave dividers, easing — is the shared brand language. */

  /* ---- hero ---- */
  .pb-hero {
    position: relative;
    padding: 200px 0 120px;
    overflow: hidden;
    z-index: 2;
  }
  .pb-hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 56px;
    align-items: center;
  }
  .pb-blob-a {
    width: min(40vw, 460px);
    top: -12%;
    right: -12%;
    opacity: 0.32;
  }
  .pb-blob-b {
    width: min(24vw, 260px);
    bottom: -10%;
    left: -8%;
    opacity: 0.3;
  }
  .pb-float {
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }
  .pb-float img {
    width: 100%;
    height: 100%;
  }
  /* pinned in the clear band between the nav and the eyebrow. A px offset (not
     a %) keeps it out of both regardless of hero height. */
  .pb-float.f1 {
    width: 68px;
    height: 68px;
    top: 122px;
    left: 2%;
    animation: bob 6s ease-in-out infinite alternate;
  }
  .pb-float.f2 {
    width: 78px;
    height: 78px;
    bottom: 14%;
    left: 42%;
    animation: bob 7.5s ease-in-out infinite alternate-reverse;
  }
  .pb-float.f3 {
    width: 70px;
    height: 70px;
    top: 10%;
    right: 40%;
    animation: bob 6.8s ease-in-out infinite alternate;
  }
  .pb-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    background: var(--butter);
    border: var(--hair);
    border-radius: 30px;
    padding: 8px 18px;
    margin-bottom: 26px;
    box-shadow: var(--sh-sm);
  }
  .pb-hero h1 {
    font-size: clamp(46px, 6.4vw, 96px);
    letter-spacing: -0.01em;
  }
  .pb-hero h1 em {
    font-family: 'Miller Text', serif;
    font-style: italic;
    color: var(--matcha);
  }
  .pb-hero-copy p {
    margin: 26px 0 36px;
    font-size: 19px;
    max-width: 46ch;
    color: rgba(47, 29, 15, 0.75);
  }
  .pb-cta-row {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  /* the tub sits in a brand shape, same device as the flavour cards */
  .pb-hero-tub {
    display: flex;
    justify-content: center;
  }
  .pb-tub-shape {
    display: grid;
    place-items: center;
    width: min(100%, 460px);
    aspect-ratio: 1;
    /* butter, not matcha: the tub crop carries a pale cream background, which
       reads as a hard rectangle against a dark fill. Matcha stays the page
       accent everywhere it doesn't sit behind packaging. */
    background: var(--butter);
    -webkit-mask: url('/assets/shapes/ribbed-circle.svg') center / 100% 100% no-repeat;
    mask: url('/assets/shapes/ribbed-circle.svg') center / 100% 100% no-repeat;
    animation: bob 9s ease-in-out infinite alternate;
  }
  .pb-tub-shape img {
    width: 84%;
    height: auto;
  }

  .pb-mq {
    margin-top: -18px;
  }

  /* ---- statement ---- */
  .pb-statement {
    text-align: center;
    background: var(--flour);
  }
  .pb-statement h2 {
    font-size: clamp(34px, 4.8vw, 68px);
    max-width: 20ch;
    margin: 0 auto;
  }
  .pb-statement h2 em {
    font-family: 'Miller Text', serif;
    font-style: italic;
    color: var(--matcha);
  }
  .pb-statement p {
    margin: 26px auto 0;
    max-width: 52ch;
    font-size: 19px;
    color: rgba(47, 29, 15, 0.75);
  }

  /* ---- benefits ---- */
  .pb-benefits {
    background: var(--matcha);
  }
  .pb-benefits h2 {
    text-align: center;
    font-size: clamp(32px, 4.4vw, 60px);
    color: var(--flour);
    margin-bottom: 56px;
  }
  .pb-ben-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  .pb-ben {
    background: var(--flour);
    border: var(--hair);
    border-radius: 28px;
    padding: 34px 28px;
    text-align: center;
    box-shadow: var(--sh-md);
    transition: transform 0.3s var(--ease);
  }
  .pb-ben-ic {
    display: block;
    width: 74px;
    height: 74px;
    margin: 0 auto 18px;
    transition: transform 0.35s var(--ease);
  }
  .pb-ben-ic img {
    width: 100%;
    height: 100%;
  }
  .pb-ben h3 {
    font-size: 21px;
    margin-bottom: 10px;
    text-wrap: balance; /* keeps two-line headings even, no orphan words */
  }
  .pb-ben p {
    font-size: 15px;
    color: rgba(47, 29, 15, 0.72);
  }

  /* ---- inside / process ---- */
  .pb-inside {
    background: var(--butterfly-pea);
    text-align: center;
  }
  .pb-inside h2 {
    font-size: clamp(32px, 4.4vw, 60px);
    margin-bottom: 12px;
  }
  .pb-lead {
    color: rgba(47, 29, 15, 0.72);
    font-size: 18px;
    max-width: 44ch;
    margin: 0 auto 62px;
  }
  .pb-step-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 34px;
  }
  .pb-step-ph {
    aspect-ratio: 1;
    width: 84%;
    margin: 0 auto 22px;
    background: var(--matcha);
    -webkit-mask: var(--shape) center / 100% 100% no-repeat;
    mask: var(--shape) center / 100% 100% no-repeat;
    transition: transform 0.4s var(--ease);
  }
  .pb-step-ph img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pb-step-n {
    font-family: 'Roketto', sans-serif;
    font-size: 14px;
    letter-spacing: 0.1em;
    color: var(--matcha);
  }
  .pb-step h3 {
    font-size: 23px;
    margin: 8px 0 10px;
  }
  .pb-step p {
    font-size: 15.5px;
    color: rgba(47, 29, 15, 0.72);
    max-width: 34ch;
    margin: 0 auto;
  }

  /* ---- full-bleed panel ---- */
  .pb-panel {
    position: relative;
    padding: 0;
    height: 78vh;
    min-height: 460px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
  }
  .pb-panel > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .pb-panel-scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(47, 29, 15, 0.8), transparent 62%);
  }
  .pb-panel-txt {
    position: relative;
    z-index: 2;
    padding: 60px;
    max-width: 640px;
    color: var(--flour);
  }
  .pb-panel-txt h3 {
    font-size: clamp(32px, 5vw, 66px);
    color: var(--flour);
  }
  .pb-panel-txt p {
    margin-top: 14px;
    font-size: 18px;
    color: rgba(252, 247, 235, 0.9);
  }

  /* ---- uses ---- */
  .pb-uses {
    background: var(--flour);
    text-align: center;
  }
  .pb-uses h2 {
    font-size: clamp(32px, 4.4vw, 60px);
    margin-bottom: 12px;
  }
  .pb-use-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .pb-use {
    background: var(--butter);
    border: var(--hair);
    border-radius: 24px;
    padding: 30px 24px;
    box-shadow: var(--sh-sm);
    transition: transform 0.3s var(--ease);
  }
  .pb-use h4 {
    font-family: 'Roketto', sans-serif;
    font-size: 19px;
    margin-bottom: 8px;
  }
  .pb-use p {
    font-size: 15px;
    color: rgba(47, 29, 15, 0.74);
  }

  /* ---- cta ---- */
  .pb-cta {
    background: var(--matcha);
    text-align: center;
    overflow: hidden;
  }
  .pb-cta-shape {
    position: absolute;
    pointer-events: none;
    opacity: 0.24;
  }
  .pb-cta-shape.a {
    width: 260px;
    left: -30px;
    top: 40px;
    animation: bob 13s ease-in-out infinite alternate;
  }
  .pb-cta-shape.b {
    width: 220px;
    right: -20px;
    bottom: 40px;
    animation: bob 16s ease-in-out infinite alternate-reverse;
  }
  .pb-cta h2 {
    font-size: clamp(38px, 5.6vw, 88px);
    color: var(--flour);
    position: relative;
  }
  .pb-cta h2 em {
    font-family: 'Miller Text', serif;
    font-style: italic;
    color: var(--biscuit);
  }
  .pb-cta p {
    margin: 20px auto 36px;
    max-width: 40ch;
    font-size: 19px;
    color: rgba(252, 247, 235, 0.9);
    position: relative;
  }
  .pb-cta .pb-cta-row {
    justify-content: center;
    position: relative;
  }

  /* hover lifts only where there's a real pointer (see global.css rationale) */
  @media (hover: hover) {
    .pb-ben:hover {
      transform: translateY(-6px);
    }
    .pb-ben:hover .pb-ben-ic {
      transform: scale(1.1) rotate(-6deg);
    }
    .pb-step:hover .pb-step-ph {
      transform: scale(1.05);
    }
    .pb-use:hover {
      transform: translateY(-5px);
    }
  }
  @media (hover: none) {
    .pb-ben:active,
    .pb-use:active {
      transform: scale(0.985);
      transition: transform 0.18s var(--ease);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pb-float,
    .pb-tub-shape,
    .pb-cta-shape {
      animation: none;
    }
    .pb-ben,
    .pb-use,
    .pb-step-ph,
    .pb-ben-ic {
      transition: none;
    }
  }

  /* ---- tablet ---- */
  @media (max-width: 1024px) {
    .pb-hero {
      padding: 168px 0 100px;
    }
    .pb-hero-grid {
      grid-template-columns: 1fr;
      gap: 44px;
      text-align: center;
    }
    .pb-hero-copy p {
      margin-left: auto;
      margin-right: auto;
    }
    .pb-cta-row {
      justify-content: center;
    }
    .pb-hero-tub {
      order: -1;
    }
    .pb-tub-shape {
      width: min(78%, 380px);
    }
    /* the hero centres and tightens below 1024px, leaving no clear space for
       the floaters — the tub is the hero visual there (same call the homepage
       makes with .float-i) */
    .pb-float {
      display: none;
    }
    .pb-ben-grid {
      grid-template-columns: 1fr 1fr;
    }
    .pb-step-grid {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    .pb-step-ph {
      width: min(70%, 320px);
    }
    .pb-use-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* ---- phone ---- */
  @media (max-width: 768px) {
    .pb-hero {
      padding: 132px 0 76px;
    }
    .pb-hero h1 {
      font-size: clamp(38px, 11vw, 54px);
    }
    .pb-hero-copy p {
      font-size: 17px;
      margin: 20px auto 28px;
    }
    .pb-tub-shape {
      width: min(74%, 300px);
    }
    .pb-mq {
      margin-top: -12px;
    }
    .pb-statement p,
    .pb-lead {
      font-size: 17px;
    }
    .pb-benefits h2,
    .pb-inside h2,
    .pb-uses h2 {
      margin-bottom: 36px;
    }
    .pb-lead {
      margin-bottom: 44px;
    }
    .pb-ben {
      padding: 26px 20px;
      border-radius: 24px;
    }
    .pb-ben-ic {
      width: 56px;
      height: 56px;
      margin-bottom: 14px;
    }
    .pb-ben h3 {
      font-size: 18px;
    }
    .pb-ben p {
      font-size: 14px;
    }
    .pb-step-ph {
      width: min(64%, 260px);
      margin-bottom: 16px;
    }
    .pb-step h3 {
      font-size: 20px;
    }
    .pb-panel {
      height: auto;
      min-height: 62vh;
    }
    .pb-panel-txt {
      padding: 40px 22px;
    }
    .pb-use {
      padding: 22px 18px;
      border-radius: 20px;
    }
    .pb-use h4 {
      font-size: 17px;
    }
    .pb-cta-shape.a {
      width: 150px;
      left: -40px;
    }
    .pb-cta-shape.b {
      width: 130px;
      right: -34px;
    }
  }

  @media (max-width: 480px) {
    .pb-ben-grid {
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    .pb-use-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .pb-cta-row .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
