---
// TODO(image-optimization): assets/img/*.jpg,*.png and assets/video/*.mov are served
// as-is from public/assets/ via plain <img>/<video src>. A later pass should move the
// images into src/assets/img/ and adopt Astro's <Image> component for automatic
// resize/compression/format conversion (webp/avif). Video has no <Image> equivalent.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import FeatureBurst from '../components/FeatureBurst.astro';
import FlavourCard from '../components/FlavourCard.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { flavours } from '../data/flavours';
import { recipes } from '../data/recipes';
import { testimonials } from '../data/testimonials';

// The two hero decorative shapes are inlined (not <img>) so main.js can
// line-draw their outline on load via anime.js's createDrawable, then fade the
// brand fill up — see playHeroIntro() + the .hero-shape rules in global.css.
// Read at build time from the same source files the rest of the site uses.
// Anchored to the project root (cwd during `astro dev`/`astro build`) rather
// than import.meta.url, which points into the bundled output at build time.
const shapeSvg = (name: string) =>
  readFileSync(join(process.cwd(), 'public/assets/shapes', `${name}.svg`), 'utf8');
const flowerSvg = shapeSvg('flower');
const quatrefoilSvg = shapeSvg('quatrefoil');

// Recipe "window" clip-path. The photos are clipped into the quatrefoil brand
// shape; while the "Cook something happy" section is in view, main.js morphs
// that shape into the rounded square below (anime.js morphTo) and eases it back
// on scroll-away. Both paths are pre-normalised to the 0..1 objectBoundingBox
// space so the clip scales with each (square) card and no transform is needed.
// The quatrefoil path is pure M/C/c (coordinate pairs only), so scaling every
// number alternately by (1/w, 1/h) normalises it exactly.
const QUAT_W = 693.46;
const QUAT_H = 706.42;
const normalizePath = (d: string, sx: number, sy: number) => {
  let i = 0;
  return d.replace(/([A-Za-z])|(-?\d*\.?\d+)/g, (_m, cmd, num) => {
    if (cmd) {
      i = 0;
      return cmd;
    }
    const v = parseFloat(num) * (i++ % 2 === 0 ? sx : sy);
    return v.toFixed(5);
  });
};
const quatrefoilD = normalizePath(quatrefoilSvg.match(/ d="([^"]+)"/)![1], 1 / QUAT_W, 1 / QUAT_H);
// Rounded square in 0..1 space (corner radius 0.16 ≈ the quatrefoil's lobe
// scale). Corners are cubic béziers, NOT arcs — anime's morphTo samples path
// commands and doesn't handle `A`, so an arc target collapses to a single point.
const recipeSquareD =
  'M0.16,0 L0.84,0 C0.928368,0 1,0.071632 1,0.16 L1,0.84 C1,0.928368 0.928368,1 0.84,1 L0.16,1 C0.071632,1 0,0.928368 0,0.84 L0,0.16 C0,0.071632 0.071632,0 0.16,0 Z';

// Product stats folded into the merged feature section (sample figures for
// client review). The count-up is driven by main.js via [data-count].
const stats = [
  { num: 82, label: '% butterfat' },
  { num: 10, label: 'mins to soften at room temperature' },
  { num: 5, label: 'more variants' },
];

// Brand-element shapes cycled onto testimonial avatars (Brand Elements – Shapes).
const qShapes = ['/assets/shapes/quatrefoil.svg', '/assets/shapes/flower.svg', '/assets/shapes/ribbed-circle.svg'];

// Photos that drift as the tilted marquee background behind the stockists
// section. Each row repeats its set twice in the markup so the translateX(-50%)
// loop wraps seamlessly (see .shelf-bg in global.css). Alternate rows run the
// set reversed and scroll the opposite way for a parallax collage.
const shelfPhotos = ['table-spread-2', 'img-aristi', 'scoops', 'img-tkachenko', 'butter-rolls', 'img-tai-1', 'banana-cream', 'img-solodsha'];
const shelfRows = [
  { cls: 'r1', imgs: shelfPhotos },
  { cls: 'r2 rev', imgs: [...shelfPhotos].reverse() },
  { cls: 'r3', imgs: shelfPhotos },
  { cls: 'r4 rev', imgs: [...shelfPhotos].reverse() },
  { cls: 'r5', imgs: shelfPhotos },
];
---
<BaseLayout title="Babs Butter · Butter that takes the cream">
  <!-- OFFER STRIP — fixed announcement bar above the nav. Doubles as a
       coming-soon notify prompt: the message opens the newsletter popup. -->
  <div class="promo" role="region" aria-label="Store announcement">
    <div class="wrap promo-inner">
      <button class="promo-msg promo-notify" type="button" data-notify-open>
        <span class="promo-long">Coming soon — </span><u>be first to the butter</u><span class="promo-long"> and stay in the swirl</span>
        <span class="promo-arrow" aria-hidden="true">→</span>
      </button>
      <div class="promo-social" aria-hidden="true">
        <span>@babsbutter</span>
        <span class="promo-cur">INR ₹</span>
      </div>
    </div>
  </div>

  <!-- HERO — full-bleed stop-motion video background -->
  <header class="hero" id="top">
    <video
      class="hero-bgimg"
      src="/assets/video/hero-stop-motion.mp4"
      poster="/assets/video/hero-stop-motion-poster.jpg"
      autoplay
      muted
      playsinline
      preload="auto"
      aria-label="Butter being spread in a stop-motion sequence"
    ></video>
    <div class="hero-scrim" aria-hidden="true"></div>
    <span class="blob spin hero-shape" aria-hidden="true" style="width:min(46vw,560px);top:-8%;right:-10%;opacity:.4" set:html={flowerSvg}></span>
    <span class="blob bob2 hero-shape" aria-hidden="true" style="width:min(28vw,320px);bottom:-6%;left:-8%;opacity:.35" set:html={quatrefoilSvg}></span>
    <div class="float-i f1"><img src="/assets/illus/butter-stick.svg" alt="" /></div>
    <div class="float-i f2"><img src="/assets/illus/croissant.svg" alt="" /></div>
    <div class="float-i f3"><img src="/assets/illus/hearts.svg" alt="" /></div>
    <div class="float-i f4"><img src="/assets/illus/butter-swirl.svg" alt="" /></div>
    <div class="wrap">
      <span class="eyebrow">🧈 precision churned &amp; super delectable</span>
      <h1><span class="w">Butter</span> <span class="w">that takes</span> <span class="w">the cream.</span></h1>
      <p>For the conscious eater who doesn&rsquo;t settle for anything less than delicious.</p>
      <div class="cta-row">
        <a class="btn orange magnetic" href="#flavs">Explore our butters</a>
        <a class="btn offwhite" href="#why">Why Babs</a>
      </div>
    </div>

    <!-- TICKER TAPE — anchored to the base of the hero, tilted like a sticker -->
    <div class="mq tilt-l" aria-hidden="true">
      <div class="track">
        <span>Chef made <img src="/assets/illus/chef-made.svg" alt="" /> Clean label <img src="/assets/illus/clean-label.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
        <span>Chef made <img src="/assets/illus/chef-made.svg" alt="" /> Clean label <img src="/assets/illus/clean-label.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
        <span>Chef made <img src="/assets/illus/chef-made.svg" alt="" /> Clean label <img src="/assets/illus/clean-label.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
        <span>Chef made <img src="/assets/illus/chef-made.svg" alt="" /> Clean label <img src="/assets/illus/clean-label.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
      </div>
    </div>
  </header>

  <!-- FLAVOURS — the "Pick your player" grid; brand-element shapes as the tub
       outlines. Now the first content section, so it carries the scalloped flour
       wave in from the hero. #flavs lands here. -->
  <section class="flavs wv no-depth" id="flavs" style="--wv-c:var(--flour)">
    <div class="flav-bg" aria-hidden="true"></div>
    <div class="wrap">
      <h2 class="rv">Pick your player</h2>
      <p class="lead rv">Different dietary needs call for different superpowers.</p>
      <div class="flav-grid">
        {flavours.map((f) => <FlavourCard {...f} />)}
      </div>
    </div>
  </section>

  <!-- PRODUCT FEATURES — the merged spiral feature section (burst + "Zero
       nasties" + stats, folding in the old why/stats sections). Sits below the
       flavours grid now; #why lands on the feature section. -->
  <FeatureBurst id="why" ctaHref="#stockists" stats={stats} />

  <!-- HOW IT'S CHURNED — photo steps; wave in from the flour flavours grid -->
  <section class="made wv no-depth" style="--wv-c:var(--flour)">
    <div class="wrap">
      <h2 class="rv">From milk to butter</h2>
      <div class="made-grid">
        <div class="made-step rv"><span class="n">01</span><div class="ph"><img src="/assets/img/scoops.jpg" alt="Fresh cream being heated" loading="lazy" /></div><h3>Cream &amp; heat</h3><p>Milk becomes cream, and then meets some warmth — just enough to knock out anything unwanted.</p></div>
        <div class="made-step rv"><span class="n">02</span><div class="ph"><img src="/assets/img/baking-bowl.jpg" alt="Small-batch cold churn" loading="lazy" /></div><h3>Churn</h3><p>Turn cold and slow to create the most delicious butter.</p></div>
        <div class="made-step rv"><span class="n">03</span><div class="ph"><img src="/assets/img/butter-cube-dark.jpg" alt="A finished cube of butter" loading="lazy" /></div><h3>Taste &amp; seal</h3><p>Every batch is tasted, then sealed cold in our premium packaging and shipped.</p></div>
      </div>
      <!-- A quiet mobile-only progress cue: it confirms that this photo story
           continues sideways without adding another competing illustration. -->
      <div class="made-swipe-progress" aria-hidden="true">
        <span class="is-active"></span><span></span><span></span>
      </div>
    </div>
  </section>

  <script>
    // Keep the tiny process indicator in sync with the native horizontal swipe.
    // The photos remain the interaction; this is simply a subtle orientation cue.
    document.querySelectorAll<HTMLElement>('.made-grid').forEach((grid) => {
      const bars = grid.parentElement?.querySelectorAll<HTMLElement>('.made-swipe-progress span');
      if (!bars?.length) return;

      const updateProgress = () => {
        const index = Math.min(bars.length - 1, Math.max(0, Math.round(grid.scrollLeft / grid.clientWidth)));
        bars.forEach((bar, barIndex) => bar.classList.toggle('is-active', barIndex === index));
      };

      grid.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
    });
  </script>

  <!-- RECIPES -->
  <section class="recipes no-depth" id="recipes">
    <!-- Per-card clip-paths for the recipe photos + the rounded-square target the
         boundary morphs to on hover (see main.js). 0×0 so it never paints. Each
         morphable shape (#rc-live-i) is a DIRECT child of the <svg>, not inside
         <clipPath> — paths inside a clipPath aren't in the render tree, so their
         getPointAtLength() can't be sampled. The clipPath references it live via
         <use>, so morphing #rc-live-i re-clips only that card's photo. One per
         card so hovering a single card morphs only its own boundary. -->
    <svg width="0" height="0" aria-hidden="true" class="rc-defs">
      {recipes.map((_, i) => (
        <Fragment>
          <path id={`rc-live-${i}`} class="rc-path" d={quatrefoilD} />
          <clipPath id={`recipe-clip-${i}`} clipPathUnits="objectBoundingBox">
            <use href={`#rc-live-${i}`} />
          </clipPath>
        </Fragment>
      ))}
      <path id="rc-square" d={recipeSquareD} />
    </svg>
    <div class="wrap">
      <h2 class="rv">Get the insider swirls!</h2>
      <p class="lead rv">Recipes. Updates. The buttery details.</p>
    </div>
    <div class="wrap">
      <div class="r-track">
        {recipes.map((r, i) => <RecipeCard {...r} index={i} />)}
      </div>
    </div>
  </section>

  <!-- INGREDIENTS — floating playground -->
  <section class="ing wv no-depth" id="ingredients" style="--wv-c:var(--butterfly-pea)">
    <img class="blob spin" src="/assets/shapes/ribbed-circle.svg" alt="" style="width:min(24vw,260px);top:-4%;left:-6%;opacity:.25" />
    <div class="ing-float i1"><img src="/assets/illus/croissant.svg" alt="" /></div>
    <div class="ing-float i2"><img src="/assets/illus/butter-stick.svg" alt="" /></div>
    <div class="ing-float i3"><img src="/assets/illus/hearts.svg" alt="" /></div>
    <div class="ing-float i4"><img src="/assets/illus/bread-butter.svg" alt="" /></div>
    <div class="ing-float i5"><img src="/assets/illus/exclamation.svg" alt="" /></div>
    <div class="wrap">
      <h2 class="rv">Our hero ingredients</h2>
      <p class="lead rv">Things we rely on!</p>
      <div class="ing-stage rv">
        <span class="pill p1"><img src="/assets/illus/milk-cream.svg" alt="" />high quality 100% milk</span>
        <span class="pill p2"><img src="/assets/illus/sea-salt.svg" alt="" />sea salt</span>
        <span class="pill p3"><img src="/assets/illus/slow-churn.svg" alt="" />the Babs signature churn</span>
      </div>
    </div>
  </section>

  <!-- VIDEO — full bleed, no white space; biscuit wave in from the ingredients above -->
  <section class="vid wv" style="--wv-c:var(--biscuit)">
    <video src="/assets/video/butter-toast.mp4" poster="/assets/video/butter-toast-poster.jpg" autoplay muted playsinline preload="auto" aria-label="Hands spreading butter on freshly toasted bread"></video>
    <span class="tag">🎬 bread &amp; butter with Babs</span>
  </section>

  <!-- TICKER TAPE reprise — tilted the other way -->
  <div class="mq tilt-r solo" aria-hidden="true">
    <div class="track">
      <span>Chef made <img src="/assets/illus/chef-made.svg" alt="" /> Clean label <img src="/assets/illus/clean-label.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
      <span>Chef made <img src="/assets/illus/chef-made.svg" alt="" /> Clean label <img src="/assets/illus/clean-label.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
      <span>Chef made <img src="/assets/illus/chef-made.svg" alt="" /> Clean label <img src="/assets/illus/clean-label.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
      <span>Chef made <img src="/assets/illus/chef-made.svg" alt="" /> Clean label <img src="/assets/illus/clean-label.svg" alt="" /> Family approved <img src="/assets/illus/hearts.svg" alt="" /> Plant-based too <img src="/assets/illus/vegan.svg" alt="" /></span>
    </div>
  </div>

  <!-- TESTIMONIALS — no wave here; the tilted banner is the only break after the video -->
  <section class="quotes no-depth" aria-labelledby="quotes-heading">
    <img class="blob bob" src="/assets/shapes/quatrefoil.svg" alt="" style="width:min(20vw,220px);top:6%;left:-5%;opacity:.35" />
    <img class="blob bob2" src="/assets/shapes/flower.svg" alt="" style="width:min(24vw,280px);bottom:4%;right:-6%;opacity:.35" />
    <div class="wrap">
      <div class="q-head rv">
        <span class="eyebrow">🧈 what&rsquo;s the verdict?</span>
        <h2 id="quotes-heading">From our amazing customers, in their own words</h2>
        <p>Chefs, foodies, fitness enthusiasts, and an uncle who reads every label… Here&rsquo;s what Babs does for them.</p>
      </div>
      <ul class="q-cols" aria-label="Customer testimonials">
        {testimonials.map((t, i) => (
          <li class="q-card">
            <img class="q-shape" src={qShapes[i % qShapes.length]} alt="" aria-hidden="true" />
            <blockquote>{t.text}</blockquote>
            <figure class="q-who">
              <span class="q-ava" style={`--shape:url('${qShapes[(i + 1) % qShapes.length]}')`}>
                <img src={t.image} alt={`Photo of ${t.name}`} width="52" height="52" loading="lazy" />
              </span>
              <figcaption><cite>{t.name}<span>{t.role}</span></cite></figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- AWARDS + RETAIL -->
  <section class="shelf wv" id="stockists" style="--wv-c:var(--butter)">
    <div class="shelf-bg" aria-hidden="true">
      <div class="shelf-carousel">
        {shelfRows.map((row) => (
          <div class={`mrow ${row.cls}`}>
            {[...row.imgs, ...row.imgs].map((name) => (
              <span class="mcard"><img src={`/assets/img/${name}.jpg`} alt="" loading="lazy" /></span>
            ))}
          </div>
        ))}
      </div>
    </div>
    <div class="wrap">
      <h2 class="rv">Where to grab us</h2>
      <div class="badges">
        <div class="b rv"><span>Delhi</span></div>
        <div class="b rv"><span>Mumbai</span></div>
        <div class="b rv"><span>Bangalore</span></div>
        <div class="b rv"><span>Nagpur</span></div>
      </div>
      <div class="retail rv">
        <p>On shelves at the good grocers. Or at your door in ten minutes.</p>
        <div class="row quick">
          <a class="qcom" href="#" aria-label="Order on Zepto"><img src="/assets/logos/zepto.svg" alt="Zepto" /></a>
          <a class="qcom" href="#" aria-label="Order on Blinkit"><img class="bl" src="/assets/logos/blinkit.svg" alt="Blinkit" /><span>blinkit</span></a>
          <span>Instamart</span>
        </div>
        <div class="row"><span>Nature's Basket</span><span>Foodhall</span><span>Le Marché</span><span>Modern Bazaar</span><span>babsbutter.com</span></div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq" id="faq">
    <div class="wrap faq-grid">
      <div class="faq-side">
        <h2 class="rv">Good questions</h2>
        <p class="rv">Curiosity makes everything butter!</p>
        <img class="faq-illus" src="/assets/illus/exclamation.svg" alt="" aria-hidden="true" />
      </div>
      <div class="faq-list">
        <details class="rv"><summary>How is butter high protein and lower calorie? <span class="x">+</span></summary><div class="a"><p>We took the fat down and brought the protein up — so our high protein lower calorie spread fits your macros without giving up the point of butter.</p></div></details>
        <details class="rv"><summary>Is the plant-based tub actually good? <span class="x">+</span></summary><div class="a"><p>High quality plant-based ingredients churned to perfection. It cooks, browns, bakes, and fools butter aficionados.</p></div></details>
        <details class="rv"><summary>Where can I buy Babs? <span class="x">+</span></summary><div class="a"><p>Coming soon pan India, starting with Mumbai, Delhi, Bangalore and Nagpur in November 2026.</p></div></details>
        <details class="rv"><summary>How long does a tub last? <span class="x">+</span></summary><div class="a"><p>Three months, chilled.</p></div></details>
      </div>
    </div>
  </section>

  <!-- CTA — full-bleed tangerine, concept-2 style -->
  <section class="cta wv" id="cta" style="--wv-c:var(--butterfly-pea)">
    <img class="cta-bg" src="/assets/img/bread-basket.jpg" alt="" aria-hidden="true" />
    <div class="cta-scrim" aria-hidden="true"></div>
    <div class="wrap">
      <h2 class="rv">Coming <em>soon.</em></h2>
      <p class="rv">Once you go Babs, you won&rsquo;t want to go back!</p>
      <button class="btn cream magnetic rv" type="button" data-notify-open>Stay in the swirl</button>
    </div>
  </section>

  <footer class="wv" style="--wv-c:var(--dark-choc)">
    <div class="wrap">
      <div class="f-grid">
        <div><img src="/assets/logos/secondary-flour.svg" alt="Babs Butter" /></div>
        <div><h4>Products</h4><ul><li><a href="#flavs">Classic Salted</a></li><li><a href="#flavs">A2 Butter</a></li><li><a href="#flavs">Plant-Based</a></li><li><a href="#flavs">High Protein</a></li><li><a href="#flavs">Unsalted Butter</a></li></ul></div>
        <div><h4>Explore</h4><ul><li><a href="#why">Why Babs</a></li><li><a href="#cta">Contact Us</a></li><li><a href="#faq">FAQ</a></li></ul></div>
        <div><h4>Follow</h4><ul><li><a href="#">@babsbutterofficial</a></li><li><a href="#">babsbutter.com</a></li></ul></div>
      </div>
      <div class="f-base"><span>© 2026 Babs Butter.</span><span>Privacy · Terms</span></div>
    </div>
  </footer>
</BaseLayout>
