---
// FeatureBurst — the radial "spiral reveal" product-info band: the tub sits
// dead-centre and six features fan out around it. On scroll-in the tub lands,
// then the callouts burst from behind it in all directions. A reusable component
// (everything here is Astro-scoped so it travels with it).
//   dx/dy — the node's offset (px) from centre at desktop size.
//   side  — 'l' nodes hang left of the tub (icon on the tub side, text reading
//           outward), 'r' nodes mirror that on the right.
interface Stat {
  num: number;
  label: string;
}
interface Props {
  id?: string;
  ctaHref?: string;
  ctaLabel?: string;
  // When provided, renders the merged two-column variant: the burst plays
  // centred, then shrinks and slides left while a "Zero nasties" headline and
  // these stats reveal on the right — folding the old why + stats sections in.
  stats?: Stat[];
}
const { id, ctaHref = '#sh-grid', ctaLabel = 'Stay in the swirl', stats } = Astro.props;
const isMerged = Array.isArray(stats) && stats.length > 0;

const features = [
  { icon: '/assets/illus/butter-swirl.svg', label: 'Golden goodness', dx: -286, dy: -166, side: 'l' },
  { icon: '/assets/illus/clean-label.svg', label: 'Clean label', dx: 286, dy: -166, side: 'r' },
  { icon: '/assets/illus/palm-free.svg', label: 'No palm oil', dx: 344, dy: 0, side: 'r' },
  { icon: '/assets/illus/pasteurised-cream.svg', label: 'Pasteurised cream', dx: 286, dy: 166, side: 'r' },
  { icon: '/assets/illus/sea-salt.svg', label: 'Sea salt', dx: -286, dy: 166, side: 'l' },
  { icon: '/assets/illus/colour-free.svg', label: 'No added colour', dx: -344, dy: 0, side: 'l' },
];
---

<!-- FEATURE BAND — central tub with features bursting out in all directions.
     When `stats` are passed it becomes the merged two-column layout (burst left,
     "Zero nasties" + stats right); otherwise it's the centred single column. -->
<section class:list={['sh-feat wv no-depth', { merged: isMerged }]} id={id} style="--wv-c:var(--flour)">
  <div class:list={['wrap', { 'sh-feat-merge': isMerged }]}>
    {!isMerged && (
      <Fragment>
        <h2 class="sh-feat-say">No <em>nasties.</em></h2>
        <p class="sh-feat-sub">Precision churned, nothing to hide. We spent our energy on quality and flavour, not filler ingredients.</p>
      </Fragment>
    )}

    {isMerged && (
      <div class="sh-feat-mobile-intro">
        <h2 class="sh-feat-say">No <em>nasties.</em></h2>
        <p class="sh-feat-sub">Precision churned, nothing to hide. We spent our energy on quality and flavour, not filler ingredients.</p>
      </div>
    )}

    <div class="sh-feat-stage">
      <div class="sh-radial">
      <div class="sh-feat-jar">
        <span class="sh-jar-shape"><img src="/assets/img/tubs/lid-design-01.svg" alt="Babs Classic Salted butter lid design" /></span>
      </div>

      <ul class="sh-feat-list" aria-label="What makes Babs better">
        {
          features.map((f, i) => (
            <li class={`sh-feat-node ${f.side}`} style={`--dx:${f.dx}px;--dy:${f.dy}px;--i:${i}`}>
              <span class="sh-feat-ic"><img src={f.icon} alt="" /></span>
              <span class="sh-feat-label">{f.label}</span>
            </li>
          ))
        }
      </ul>
      </div>
    </div>

    {
      isMerged ? (
        <div class="sh-feat-info">
          <h2 class="sh-feat-say">No <em>nasties.</em></h2>
          <p class="sh-feat-sub">Precision churned, nothing to hide. We spent our energy on quality and flavour, not filler ingredients.</p>
          <div class="sh-stats">
            {stats!.map((s) => (
              <div class="sh-stat">
                <span class="sh-stat-num" data-count={s.num}>0</span>
                <p>{s.label}</p>
              </div>
            ))}
          </div>
          <a class="btn magnetic sh-info-cta" href={ctaHref}>{ctaLabel}</a>
        </div>
      ) : (
        <div class="sh-feat-foot">
          <a class="btn magnetic" href={ctaHref}>{ctaLabel}</a>
        </div>
      )
    }
  </div>
</section>

<script>
  // Reveal — the tub scales in first, then each feature bursts out from
  // behind it, then the copy/button settle. Gated on motion preference: the
  // hidden start states live under `.sh-feat.anim` (added here), so no-JS and
  // reduced-motion visitors always see the band fully in place.
  const feat = document.querySelector('.sh-feat');
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (feat && !reduceMotion) {
    feat.classList.add('anim');

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          feat.classList.add('in-view');

          // merged variant: once the burst has played centred, shrink it to
          // the left and reveal the "Zero nasties" + stats column on the right
          if (feat.classList.contains('merged')) {
            setTimeout(() => feat.classList.add('settled'), 1500);
          }
          io.disconnect();
        });
      },
      { threshold: 0.35 }
    );
    io.observe(feat);
  }
</script>

<style>
  /* ---- feature band (radial burst) ---- */
  .sh-feat {
    background: var(--flour);
    text-align: center;
  }
  .sh-feat-say {
    font-size: clamp(30px, 3.6vw, 52px);
    color: var(--tangerine);
    max-width: 20ch;
    margin: 0 auto;
  }
  .sh-feat-say em {
    font-family: 'Miller Text', serif;
    font-style: italic;
    color: var(--dark-choc);
  }
  .sh-feat-sub {
    margin: 18px auto 0;
    max-width: 54ch;
    font-size: 18px;
    color: rgba(47, 29, 15, 0.72);
  }

  /* the stage the tub and its callouts live on. Fixed pixel geometry (matching
     the dx/dy in the frontmatter); it collapses to a centred stack below the
     radial breakpoint. */
  .sh-radial {
    position: relative;
    width: 960px;
    height: 500px;
    max-width: 100%;
    margin: 40px auto 8px;
  }

  /* central tub */
  .sh-feat-jar {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 3; /* callouts tuck behind it on reveal */
  }
  .sh-jar-shape {
    display: grid;
    place-items: center;
    width: 330px;
    height: 330px;
    background: #e96324;
    -webkit-mask: url('/assets/shapes/ribbed-circle.svg') center / 100% 100% no-repeat;
    mask: url('/assets/shapes/ribbed-circle.svg') center / 100% 100% no-repeat;
    animation: bob 9s ease-in-out infinite alternate;
  }
  .sh-jar-shape img {
    width: 86%;
    height: auto;
  }

  /* feature callouts, positioned by their offset from centre */
  .sh-feat-list {
    position: absolute;
    inset: 0;
    z-index: 2;
    list-style: none;
    margin: 0;
  }
  .sh-feat-node {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
    transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy)));
  }
  /* left-hand nodes mirror: icon stays on the tub side, label reads outward */
  .sh-feat-node.l {
    flex-direction: row-reverse;
  }
  .sh-feat-ic {
    display: grid;
    place-items: center;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: var(--butter);
    border: var(--hair);
    box-shadow: var(--sh-sm);
    flex: none;
  }
  .sh-feat-ic img {
    width: 32px;
    height: 32px;
  }
  .sh-feat-label {
    font-family: 'Roketto', sans-serif;
    font-size: clamp(19px, 2.1vw, 25px);
    color: var(--dark-choc);
  }

  .sh-feat-foot {
    margin-top: 24px;
  }

  /* ---- reveal ----
     `.anim` is added by JS (never under reduced motion / no-JS), so these
     hidden start states only exist when we can animate out of them. `.in-view`
     (set by the IntersectionObserver) plays the sequence: tub lands, then
     arrows shoot outward and callouts burst from behind it in all directions,
     then the button. Nodes/arrows collapse to the tub centre while hidden, so
     they appear to fly out of it. */
  .sh-feat.anim .sh-feat-say,
  .sh-feat.anim .sh-feat-sub {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
  }
  .sh-feat.anim .sh-feat-sub {
    transition-delay: 120ms;
  }
  .sh-feat.anim .sh-feat-jar {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0.7);
    transition: opacity 0.55s var(--ease), transform 0.55s var(--ease);
    transition-delay: 120ms;
  }
  .sh-feat.anim .sh-feat-node {
    opacity: 0;
    /* collapse onto the tub centre (kill the dx/dy offset) and shrink */
    transform: translate(-50%, -50%) scale(0.35);
    transition: opacity 0.5s var(--ease), transform 0.6s var(--ease);
  }
  .sh-feat.anim .sh-feat-foot {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
  }

  .sh-feat.anim.in-view .sh-feat-say,
  .sh-feat.anim.in-view .sh-feat-sub {
    opacity: 1;
    transform: none;
  }
  .sh-feat.anim.in-view .sh-feat-jar {
    opacity: 1;
    transform: translate(-50%, -50%);
  }
  .sh-feat.anim.in-view .sh-feat-node {
    opacity: 1;
    transform: translate(calc(-50% + var(--dx)), calc(-50% + var(--dy)));
    /* callouts fire just behind their arrows, one after another */
    transition-delay: calc(440ms + var(--i, 0) * 80ms);
  }
  .sh-feat.anim.in-view .sh-feat-foot {
    opacity: 1;
    transform: none;
    transition-delay: 980ms;
  }

  @media (prefers-reduced-motion: reduce) {
    .sh-jar-shape {
      animation: none;
    }
  }

  /* ---- tablet & below ----
     The radial burst needs ~960px to fit, so below that it falls back to a
     centred stack: tub on top, callouts in a vertical list, arrows dropped.
     The reveal is remapped to a simple staggered rise (the fly-from-centre
     transforms assume the absolute geometry that only exists on desktop). */
  @media (max-width: 1024px) {
    .sh-radial {
      width: auto;
      height: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 24px;
      max-width: 440px;
      margin: 36px auto 8px;
    }
    .sh-feat-jar {
      position: static;
      transform: none;
    }
    .sh-jar-shape {
      width: 240px;
      height: 240px;
    }
    .sh-feat-list {
      position: static;
      display: flex;
      flex-direction: column;
      gap: 16px;
      width: 100%;
    }
    .sh-feat-node,
    .sh-feat-node.l {
      position: static;
      transform: none;
      flex-direction: row;
      justify-content: flex-start;
      width: 100%;
    }
    .sh-feat.anim .sh-feat-jar {
      transform: scale(0.82) translateY(12px);
    }
    .sh-feat.anim.in-view .sh-feat-jar {
      transform: none;
    }
    .sh-feat.anim .sh-feat-node {
      transform: translateY(16px);
    }
    .sh-feat.anim.in-view .sh-feat-node {
      transform: none;
      transition-delay: calc(200ms + var(--i, 0) * 70ms);
    }
  }

  @media (max-width: 768px) {
    .sh-jar-shape {
      width: 200px;
      height: 200px;
    }
    .sh-feat-list {
      max-width: 300px;
      margin: 0 auto;
    }
    .sh-feat-label {
      font-size: 20px;
    }
  }

  /* ===== merged variant — burst + "Zero nasties" + stats in one section =====
     Below the two-column breakpoint it simply stacks: burst on top (using the
     shared radial fallback), then the info block centred underneath. */
  .sh-feat.merged {
    text-align: center;
  }
  .sh-feat-mobile-intro {
    display: none;
  }
  .sh-feat.merged .sh-feat-info {
    margin-top: 28px;
  }
  .sh-feat-info .sh-feat-say {
    max-width: none;
  }
  .sh-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 30px;
    margin: 26px 0 30px;
  }
  .sh-stat-num {
    display: block;
    font-family: 'Roketto', sans-serif;
    font-size: clamp(40px, 4.4vw, 60px);
    line-height: 1;
    color: var(--tangerine);
  }
  .sh-stat p {
    margin-top: 8px;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.07em;
    color: rgba(47, 29, 15, 0.7);
  }
  .sh-info-cta {
    margin-top: 4px;
  }

  /* two-column layout + the shrink-and-slide-left choreography (desktop only —
     the fly-from-centre geometry needs the width). */
  @media (min-width: 1025px) {
    .sh-feat.merged {
      text-align: left;
    }
    .sh-feat-merge {
      display: grid;
      grid-template-columns: 596px 1fr;
      gap: 40px;
      align-items: center;
    }
    /* the stage reserves the burst's scaled footprint; the radial keeps its
       full 960×500 internal geometry and is scaled to fit inside it */
    .sh-feat.merged .sh-feat-stage {
      position: relative;
      width: 596px;
      height: 340px;
    }
    .sh-feat.merged .sh-radial {
      position: absolute;
      top: 50%;
      left: 50%;
      margin: 0;
      transform: translate(-50%, -50%) scale(0.62);
    }
    .sh-feat.merged .sh-feat-info {
      margin-top: 0;
    }

    /* choreography: while `.anim` (pre-settle) the stage is enlarged and shifted
       to the section centre and the info is hidden to the right; adding
       `.settled` transitions the stage back into its left cell and reveals the
       info. Without `.anim` (no-JS / reduced motion) both sit at rest. */
    .sh-feat.merged.anim .sh-feat-stage {
      transform: translateX(50%) scale(1.25);
      transition: transform 0.85s var(--ease);
    }
    .sh-feat.merged.anim.settled .sh-feat-stage {
      transform: none;
    }
    .sh-feat.merged.anim .sh-feat-info {
      opacity: 0;
      transform: translateX(30px);
      transition: opacity 0.7s var(--ease) 0.1s, transform 0.7s var(--ease) 0.1s;
    }
    .sh-feat.merged.anim.settled .sh-feat-info {
      opacity: 1;
      transform: none;
    }
  }

  /* Phone-only version of the desktop burst. The original mobile fallback
     flattened this into a static list and removed the hand-drawn arrows; this
     keeps the product moment, with the labels arranged around a compact tub. */
  @media (max-width: 680px) {
    .sh-feat.merged .sh-feat-mobile-intro {
      display: block;
      margin: 0 auto 6px;
      text-align: center;
    }
    .sh-feat.merged .sh-feat-info .sh-feat-say,
    .sh-feat.merged .sh-feat-info .sh-feat-sub {
      display: none;
    }
    .sh-feat.merged .sh-feat-mobile-intro .sh-feat-sub {
      max-width: 27ch;
      margin-top: 12px;
      font-size: 16px;
      line-height: 1.45;
    }
    .sh-feat.merged .sh-radial {
      position: relative;
      display: block;
      width: min(100%, 390px);
      height: 338px;
      max-width: none;
      margin: 12px auto 0;
    }
    .sh-feat.merged .sh-feat-jar {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
    }
    .sh-feat.merged .sh-jar-shape {
      width: 150px;
      height: 150px;
    }
    .sh-feat.merged .sh-feat-list {
      position: absolute;
      inset: 0;
      display: block;
      width: auto;
      max-width: none;
      margin: 0;
    }
    .sh-feat.merged .sh-feat-node,
    .sh-feat.merged .sh-feat-node.l {
      position: absolute;
      display: flex;
      width: auto;
      gap: 6px;
      justify-content: initial;
      line-height: 1;
      white-space: nowrap;
      transform: none;
    }
    .sh-feat.merged .sh-feat-node.l {
      flex-direction: row-reverse;
    }
    .sh-feat.merged .sh-feat-node:nth-child(1) { top: 24px; left: 0; }
    .sh-feat.merged .sh-feat-node:nth-child(2) { top: 24px; right: 0; }
    .sh-feat.merged .sh-feat-node:nth-child(3) { top: 146px; right: 0; }
    .sh-feat.merged .sh-feat-node:nth-child(4) { right: 0; bottom: 20px; }
    .sh-feat.merged .sh-feat-node:nth-child(5) { bottom: 20px; left: 0; }
    .sh-feat.merged .sh-feat-node:nth-child(6) { top: 146px; left: 0; }
    .sh-feat.merged .sh-feat-ic {
      width: 43px;
      height: 43px;
      box-shadow: var(--sh-sm);
    }
    .sh-feat.merged .sh-feat-ic img {
      width: 25px;
      height: 25px;
    }
    .sh-feat.merged .sh-feat-label {
      font-size: clamp(13px, 3.8vw, 16px);
    }
    .sh-feat.merged.anim .sh-feat-jar {
      transform: translate(-50%, -50%) scale(0.72);
    }
    .sh-feat.merged.anim.in-view .sh-feat-jar {
      transform: translate(-50%, -50%);
    }
    .sh-feat.merged.anim .sh-feat-node {
      opacity: 0;
      transform: translateY(10px) scale(0.88);
    }
    .sh-feat.merged.anim.in-view .sh-feat-node {
      opacity: 1;
      transform: none;
      transition-delay: calc(420ms + var(--i, 0) * 80ms);
    }
    .sh-feat.merged .sh-feat-info {
      margin-top: 12px;
    }
    .sh-feat.merged .sh-stats {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px 8px;
      margin: 22px 0 26px;
      text-align: center;
    }
    .sh-feat.merged .sh-stat-num {
      font-size: clamp(38px, 12vw, 50px);
    }
    .sh-feat.merged .sh-stat p {
      margin-top: 6px;
      font-size: 9px;
      line-height: 1.25;
      letter-spacing: 0.045em;
    }
  }

  @media (max-width: 390px) {
    .sh-feat.merged .sh-radial {
      height: 338px;
    }
    .sh-feat.merged .sh-feat-label {
      font-size: 13px;
    }
    .sh-feat.merged .sh-feat-node:nth-child(1) { left: -2px; }
    .sh-feat.merged .sh-feat-node:nth-child(2) { right: -2px; }
    .sh-feat.merged .sh-feat-node:nth-child(4) { right: -2px; }
    .sh-feat.merged .sh-feat-node:nth-child(5) { left: -2px; }
  }

  @media (max-width: 360px) {
    .sh-feat.merged .sh-feat-node:nth-child(4) .sh-feat-label {
      width: 98px;
      white-space: normal;
      line-height: 1.08;
    }
  }
</style>
