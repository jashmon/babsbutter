---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Babs Butter · Big Butter Energy',
  description = 'Slow-churned, clean-label butter that takes the cream seriously and nothing else. Come play.',
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" />

    <!--
      Runs synchronously before first paint. Two jobs:
        1. Add `.js` (progressive-enhancement hook for any JS-gated CSS).
        2. Set scroll restoration to manual so the browser doesn't animate a
           scroll back to the previous position on reload — with
           html{scroll-behavior:smooth} that restore is smooth, and reads as the
           whole page sliding up on every refresh. Manual = load at top, instantly.
      Must stay is:inline — an external fetch would run too late (after the
      browser has already begun restoring scroll).
    -->
    <script is:inline>
      (function () {
        document.documentElement.classList.add('js');
        try {
          if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        } catch (e) {}
      })();
    </script>

    <link rel="preload" href="/assets/fonts/Roketto.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/assets/fonts/PublicSans.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="stylesheet" href="/assets/fonts.css" />
  </head>
  <body>
    <div id="blob" aria-hidden="true"></div>

    <nav>
      <div class="bar">
        <a class="logo" href="#top"><img src="/assets/logos/lockup-tangerine.svg" alt="Babs Butter" /></a>
        <ul>
          <li><a href="#flavs">Flavours</a></li>
          <li><a href="#why">Why Babs</a></li>
          <li><a href="#recipes">Recipes</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>
        <a class="btn small" href="#cta">Get Babs</a>
      </div>
    </nav>

    <slot />

    <script src="../scripts/main.js"></script>
  </body>
</html>
